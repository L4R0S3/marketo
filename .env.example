# Supabase — projet hébergé (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role — opérations serveur privilégiées uniquement (jamais exposée au client)
# SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — extraction (phase 2), modèle claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- Rappels ---
# Migrations : supabase link --project-ref <ref> puis supabase db push
#   (fichiers versionnés dans supabase/migrations/)
